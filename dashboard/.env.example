# Shared
APP_ENV=development
AGENCY_ID=default-agency
AGENCY_API_KEY=change-this-to-a-long-random-secret

# OpenAI (optional locally; deterministic mock qualification is used if absent)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Supabase (optional locally; SQLite fallback is used if either value is absent)
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Resend (optional; email is logged in mock mode if absent)
RESEND_API_KEY=
RESEND_FROM_EMAIL=Real Estate Team <onboarding@resend.dev>

# Slack alert webhook (optional; alert is printed in mock mode if absent)
SLACK_WEBHOOK_URL=

# Optional Twilio SMS fallback for hot leads
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=
AGENT_ALERT_PHONE=

# Backend URL used by Streamlit simulator
API_BASE_URL=http://127.0.0.1:8000
